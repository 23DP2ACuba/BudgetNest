# Copy this file to .env.production on the VM and replace every example value.
# Do not commit .env.production.
#
# For HTTPS, set SITE_ADDRESS to a DNS name that points to the VM and set
# APP_URL to the matching https:// URL. For a temporary IP-only test, use
# SITE_ADDRESS=:80 and APP_URL=http://YOUR_VM_EXTERNAL_IP.
SITE_ADDRESS=:80
APP_URL=http://YOUR_VM_EXTERNAL_IP

# Generate a key with: openssl rand -base64 32
# Prefix the generated value with "base64:".
APP_KEY=base64:REPLACE_WITH_GENERATED_VALUE

DB_DATABASE=budgetnest
DB_USERNAME=budgetnest_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
